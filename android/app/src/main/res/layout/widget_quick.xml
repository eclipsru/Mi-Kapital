<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="6dp" android:background="@drawable/widget_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <TextView android:id="@+id/add_income" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="+ Доход" android:textColor="#FFFFFF" android:textSize="12sp"/>
    <TextView android:id="@+id/add_expense" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="+ Расход" android:textColor="#FFFFFF" android:textSize="12sp"/>
    <TextView android:id="@+id/add_job" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="+ Работа" android:textColor="#FFFFFF" android:textSize="12sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
    <TextView android:id="@+id/add_product" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="+ Товар" android:textColor="#FFFFFF" android:textSize="12sp"/>
    <TextView android:id="@+id/add_debt" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="+ Долг" android:textColor="#FFFFFF" android:textSize="12sp"/>
  </LinearLayout>
</LinearLayout>
