{
  "name": "mi-kapital",
  "version": "2.0.0",
  "private": true,
  "description": "Личный учёт капитала, доходов и долгов с обновлениями внутри приложения",
  "author": "eclipsru",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis --publish never && npm run update:build",
    "update:build": "node scripts/build-update.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "visual": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@sparticuz/chromium": "149.0.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "happy-dom": "21.0.4",
    "playwright-core": "1.65.0",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "ru.eclipsru.mikapital",
    "productName": "Мой капитал",
    "executableName": "Mi-Kapital",
    "artifactName": "Mi-Kapital-Setup-${version}.${ext}",
    "asar": true,
    "files": ["dist/**/*", "electron/**/*", "assets/icon.png", "assets/icon.ico", "package.json"],
    "directories": { "output": "release", "buildResources": "assets" },
    "publish": [{ "provider": "github", "owner": "eclipsru", "repo": "Mi-Kapital", "releaseType": "release" }],
    "win": { "target": ["nsis"], "icon": "assets/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Мой капитал",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    }
  }
}
